# Where your database is, and the key the browser uses to reach it. Both are public by construction: they
# ship in what the browser downloads anyway, and it is the RLS policies that protect the data, not their
# secrecy. Leave them empty and the app will say so rather than fail silently.
#
# From supabase.com: Project settings, API, "Project URL" and the "anon public" key.
# From a local stack (`pnpm db:start`): the CLI prints both when it finishes starting.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: forwards crashes to your own Sentry project, in addition to the built-in `client_errors`
# table. Leave empty and nothing changes — no second sink, no extra network call. Every other instance
# is unaffected either way, since this is read per-instance from config.js, not baked into the image.
PUBLIC_SENTRY_DSN=

# Optional: the sign-in services offered next to email, comma-separated, in the order you want them. The
# platform's own account comes first (Google on Android, Apple on iOS, Google then Apple on the web) and
# the others sit behind a "More" button. Known ids: google, apple, facebook, azure (Microsoft), github,
# gitlab, discord, twitch, linkedin_oidc, slack_oidc, twitter, spotify, notion, bitbucket. Each one must also
# be enabled in Supabase (Authentication, Sign In / Providers) with its own OAuth application, or its button
# will fail. Empty: email only.
PUBLIC_OAUTH_PROVIDERS=

# Port the app is served on by `docker compose up`.
PORT=8080

# Optional, only with `docker compose --profile ntfy up -d`: the public https address of your ntfy server
# and the local port it listens on. See "Push notifications" in SELF-HOSTING.md.
NTFY_BASE_URL=
NTFY_PORT=8081
