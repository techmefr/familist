{
	"name": "familist",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"version": "0.1.1",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "node scripts/ocr-assets.mjs && vite dev",
		"build": "node scripts/ocr-assets.mjs && vite build",
		"preview": "vite preview",
		"capacitor:copy:after": "node scripts/ocr-assets.mjs --prune-native",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"setup": "node scripts/setup.mjs",
		"selfhost": "node scripts/selfhost.mjs",
		"admin": "node scripts/admin.mjs",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"release:changelog": "changelogen --bump --output CHANGELOG.md",
		"release:notes": "node scripts/patch-notes.ts"
	},
	"changelog": {
		"repo": "techmefr/FamiList",
		"noAuthors": true
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.1",
		"@capacitor/cli": "^8.6.3",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^4.1.12",
		"changelogen": "^0.6.2",
		"jsqr": "^1.4.0",
		"supabase": "^2.122.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@capacitor-mlkit/barcode-scanning": "^8.2.2",
		"@capacitor/android": "^8.6.3",
		"@capacitor/browser": "^8.0.5",
		"@capacitor/core": "^8.6.3",
		"@capacitor/geolocation": "^8.2.5",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.6.3",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/push-notifications": "^8.1.3",
		"@capacitor/share": "^8.0.3",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
		"@capgo/capacitor-speech-recognition": "^8.6.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/fredoka": "^5.3.0",
		"@fontsource/schibsted-grotesk": "^5.3.0",
		"@jis3r/icons": "^2.9.0",
		"@lucide/svelte": "^1.81.0",
		"@supabase/supabase-js": "^2.119.2",
		"@tesseract.js-data/ara": "1.0.0",
		"@tesseract.js-data/chi_sim": "1.0.0",
		"@tesseract.js-data/deu": "1.0.0",
		"@tesseract.js-data/eng": "1.0.0",
		"@tesseract.js-data/fra": "1.0.0",
		"@tesseract.js-data/ita": "1.0.0",
		"@tesseract.js-data/por": "1.0.0",
		"@tesseract.js-data/rus": "1.0.0",
		"@tesseract.js-data/spa": "1.0.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"dexie": "^4.4.7",
		"driver.js": "^1.14.0",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"tesseract.js": "7.0.0"
	}
}
